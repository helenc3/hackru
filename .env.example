# Server-only values; never use VITE_ for a secret.
# Text dialogue uses Claude when ANTHROPIC_API_KEY is set, else Gemini. Voice relay always needs Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
# Streamed city composition by Claude is opt-in; otherwise a seeded fallback builds every chunk.
ENABLE_CLAUDE_CITY=false
CITY_MODEL=claude-sonnet-5-5
# Whole-line English for shift-click glosses when no authored translation exists (needs ANTHROPIC_API_KEY).
DICTIONARY_MODEL=claude-sonnet-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Defaults to gemini-3.8-live when blank.
GEMINI_LIVE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_STT_MODEL=scribe_v2
ENABLE_DEMO_FIXTURES=false
ENABLE_VALIDATION_HARNESS=false
PORT=3001
# Bind address; default 127.0.0.1. Hosted deployments set 0.0.0.0.
HOST=
# Optional local-only UI preview; server still independently controls validation.
VITE_ENABLE_VALIDATION_HARNESS=false
