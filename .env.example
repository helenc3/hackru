# Server-only values; never use VITE_ for a secret.
# Text dialogue uses Claude when ANTHROPIC_API_KEY is set, else Gemini. Voice relay always needs Gemini.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_LIVE_MODEL=
ELEVENLABS_API_KEY=
ELEVENLABS_TTS_MODEL=eleven_v4_turbo
ELEVENLABS_PA_MODEL=eleven_v4
ELEVENLABS_STT_MODEL=scribe_v2
ENABLE_DEMO_FIXTURES=false
ENABLE_VALIDATION_HARNESS=false
PORT=3001
# Optional local-only UI preview; server still independently controls validation.
VITE_ENABLE_VALIDATION_HARNESS=false
